# ============================================================================
# Pushpa Veda — example environment variables
# Copy to `.env` and fill in YOUR OWN values. Never commit a real .env file.
# NEVER place any of these values in client-side / frontend code.
# ============================================================================

# ---- App ----
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Pushpa Veda"

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pushpa_veda
DATABASE_SSL=false

# ---- Authentication ----
# Generate a strong random secret; do not reuse the placeholder.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_PROVIDER_URL=

# ---- Search ----
# Optional: leave blank to use PostgreSQL full-text search.
SEARCH_ENGINE_URL=
SEARCH_API_KEY=

# ---- Image storage / CDN (optional) ----
# Object-storage credentials for licensed photography. Server-side only.
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_REGION=
IMAGE_STORAGE_ACCESS_KEY=
IMAGE_STORAGE_SECRET_KEY=
IMAGE_CDN_BASE_URL=

# ---- Plant-identification service (optional, future Visual Identifier) ----
# If enabled, route through a secure backend only — never expose the key to the browser.
PLANT_ID_PROVIDER=
PLANT_ID_API_KEY=

# ---- Email / newsletter (optional) ----
NEWSLETTER_API_KEY=
CONTACT_EMAIL=hello@example.org
